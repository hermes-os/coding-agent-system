{
  "description": "Repository worker. Does one kanban card's coding task inside a workbench container and hands back commits on the card's own branch.",
  "agreement": true,
  "skills": ["systematic-debugging", "test-driven-development", "requesting-code-review"],
  "config": {
    "model.provider": "openai-codex",
    "model.default": "gpt-5.6-luna",
    "fallback_providers": [],
    "agent.reasoning_effort": "high",
    "memory.memory_enabled": false,
    "memory.user_profile_enabled": false,
    "approvals.mode": "off",
    "toolsets": ["terminal", "file", "code_execution", "web", "vision", "skills", "todo", "delegation", "kanban"],
    "terminal.backend": "docker",
    "terminal.docker_image": "localhost/workbench:latest",
    "terminal.docker_mount_cwd_to_workspace": true,
    "terminal.docker_volumes": [
      "/home/hermes/workbench:/home/hermes/workbench",
      "/home/hermes/.cache/workbench:/cache"
    ],
    "terminal.docker_env": {
      "GIT_AUTHOR_NAME": "Hermes",
      "GIT_AUTHOR_EMAIL": "wrenfamilyvacation@gmail.com",
      "GIT_COMMITTER_NAME": "Hermes",
      "GIT_COMMITTER_EMAIL": "wrenfamilyvacation@gmail.com"
    },
    "terminal.container_persistent": false,
    "terminal.docker_persist_across_processes": false,
    "terminal.container_cpu": 2,
    "terminal.container_memory": 7168,
    "terminal.container_disk": 0,
    "terminal.timeout": 900
  }
}
