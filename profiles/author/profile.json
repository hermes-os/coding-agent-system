{
  "description": "Guide author. Does one round of one Ashwren study guide inside a workbench container that sees that guide's work directory and nothing else.",
  "agreement": false,
  "skills": [],
  "config": {
    "model.provider": "anthropic",
    "model.default": "claude-fable-5-2",
    "fallback_providers": [],
    "agent.reasoning_effort": "high",
    "memory.memory_enabled": false,
    "memory.user_profile_enabled": false,
    "approvals.mode": "off",
    "platform_toolsets.cli": [
      "terminal",
      "file",
      "code_execution",
      "todo"
    ],
    "terminal.backend": "docker",
    "terminal.docker_image": "localhost/workbench:latest",
    "terminal.docker_mount_cwd_to_workspace": false,
    "terminal.cwd": "/workspace",
    "terminal.docker_run_as_host_user": true,
    "terminal.docker_extra_args": ["--userns=keep-id", "--cap-add", "SYS_CHROOT"],
    "terminal.docker_network": false,
    "terminal.container_persistent": false,
    "terminal.docker_persist_across_processes": false,
    "terminal.container_cpu": 2,
    "terminal.container_memory": 4096,
    "terminal.container_disk": 0,
    "terminal.timeout": 900
  }
}
