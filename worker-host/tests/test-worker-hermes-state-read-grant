#!/usr/bin/env python3
"""Verify the host owner can read a Hermes run's state.db files and nothing that holds credentials.

The grant is checked with a real getfacl round trip. The grant user is STATE_READ_TEST_USER
(default nobody): the files belong to the user running the test, who can read them anyway, so a
second user shows that the ACL, not ownership, carries the access.
"""

from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path
import contextlib
import io
import json
import os
import pwd
import sqlite3
import subprocess
import sys
import tempfile
import types


WORKER_HOST = Path(__file__).resolve().parents[1]
ADAPTER = WORKER_HOST / "libexec" / "agent-worker-hermes" / "host" / "bin" / "agent-hermes-worker"

loader = SourceFileLoader("agent_hermes_worker_state_grant_test", str(ADAPTER))
spec = spec_from_loader(loader.name, loader)
adapter = module_from_spec(spec)
sys.modules[loader.name] = adapter
loader.exec_module(adapter)

READER = os.environ.get("STATE_READ_TEST_USER", "nobody")
try:
    READER_UID = pwd.getpwnam(READER).pw_uid
except KeyError:
    raise SystemExit(f"grant user {READER} does not exist; set STATE_READ_TEST_USER")
adapter.STATE_READER_NAME = READER
# Workers run with UMask=0077.
os.umask(0o077)


def grant_state_read(home):
    return adapter.grant_state_read(home, READER_UID)


def acl(path):
    output = subprocess.run(
        ["getfacl", "--omit-header", "--absolute-names", "--physical", "--", str(path)],
        check=True, capture_output=True, text=True,
    ).stdout
    # "#effective:" annotations only appear when the mask narrows an entry; strip them.
    return {line.split("#")[0].strip() for line in output.splitlines() if line.strip()}


def default_acl(path):
    output = subprocess.run(
        ["getfacl", "--omit-header", "--absolute-names", "--default", "--", str(path)],
        check=True, capture_output=True, text=True,
    ).stdout
    return {line.strip() for line in output.splitlines() if line.strip()}


def granted(path, perm, owner="rw-"):
    return acl(path) == {f"user::{owner}", f"user:{READER}:{perm}", "group::---", "mask::" + perm, "other::---"}


def require_granted(path, perm, owner="rw-"):
    if not granted(path, perm, owner):
        raise SystemExit(f"{path.name}: expected only u:{READER}:{perm}, got {sorted(acl(path))}")


def require_private(path):
    entries = acl(path)
    if any(entry.startswith(f"user:{READER}:") or entry.startswith("mask::") for entry in entries):
        raise SystemExit(f"{path.name} is granted to {READER}: {sorted(entries)}")
    if os.lstat(path).st_mode & 0o077:
        raise SystemExit(f"{path.name} has group or other mode bits: {oct(os.lstat(path).st_mode)}")


def refused(home, reason):
    try:
        adapter.check_directory(home, fresh=False)
    except adapter.BridgeError as exc:
        if exc.code != "unsafe_runtime_home":
            raise SystemExit(f"{reason}: refused with {exc.code}, not unsafe_runtime_home")
        return
    raise SystemExit(f"{reason}: the resume home was accepted")


# A stand-in for the pinned Hermes: it opens state.db in WAL mode and keeps it open, chmods the
# database files 0600 and its home 0700 as Hermes does, waits for the adapter's once-a-second
# refresh to restore the grant (a little over a second) and records whether it saw it, then resets
# the modes again and exits without closing, so -wal and -shm stay and only the refresh after exit
# can grant them again.
FAKE_HERMES = """
import os, sqlite3, sys, time
home = os.environ["HERMES_HOME"]
paths = [os.path.join(home, name) for name in ("state.db", "state.db-wal", "state.db-shm")]
os.chmod(home, 0o700)
db = sqlite3.connect(paths[0])
db.execute("PRAGMA journal_mode=WAL")
db.execute("CREATE TABLE IF NOT EXISTS sessions (id TEXT PRIMARY KEY)")
db.execute("INSERT INTO sessions (id) VALUES ('20261028_130000_abcdef')")
db.commit()

def secure():
    for path in paths:
        os.chmod(path, 0o600)
    os.chmod(home, 0o700)

def granted():
    # With an ACL the group bits are its mask: r-- on the files, --x on the home.
    return (all(os.stat(path).st_mode & 0o070 == 0o040 for path in paths)
            and os.stat(home).st_mode & 0o070 == 0o010)

secure()
deadline = time.monotonic() + 2.5
while not granted() and time.monotonic() < deadline:
    time.sleep(0.02)
with open(sys.argv[1], "w") as report:
    report.write("granted" if granted() else "missing")
secure()
os.write(2, b"session_id: 20261028_130000_abcdef\\n")
os.write(1, b"done\\n")
os._exit(0)
"""


def run_adapter_main(runtime_home, fake, report):
    """Run the adapter's main() for one fresh write run against the fake Hermes."""
    original_runtime, original_stdin = adapter.resolve_hermes_runtime, sys.stdin
    original_env = {name: os.environ.get(name) for name in ("AGENT_WORKER_MANAGED", "AGENT_ACCESS_MODE")}
    # The fake reads the report path as its first argument; the adapter appends its own after it.
    adapter.resolve_hermes_runtime = lambda: (sys.executable, "-I", str(fake), str(report))
    sys.stdin = types.SimpleNamespace(buffer=io.BytesIO(b"read the state grant\n"))
    os.environ.update(AGENT_WORKER_MANAGED="1", AGENT_ACCESS_MODE="write")
    output = io.StringIO()
    try:
        with contextlib.redirect_stdout(output):
            returncode = adapter.main([
                "--provider", "openrouter", "--model", "test/model", "--effort", "low", "--access", "write",
                "--runtime-home", str(runtime_home),
                "--broker-session-id", "0f6c1e9a-2b3d-4c5e-8f70-112233445566", "--fresh-session",
            ])
    finally:
        adapter.resolve_hermes_runtime, sys.stdin = original_runtime, original_stdin
        for name, value in original_env.items():
            if value is None:
                os.environ.pop(name, None)
            else:
                os.environ[name] = value
    events = [json.loads(line) for line in output.getvalue().splitlines() if line.strip()]
    return returncode, events


def other_owner_case():
    """As root (real, or mapped in a user namespace): a state file or run home owned by another uid
    is never granted, though root could set the ACL."""
    with tempfile.TemporaryDirectory() as scratch:
        root = Path(scratch) / ".hermes-worker"
        root.mkdir(mode=0o700)
        home = root / "6e5d4c3b-2a19-4807-9f6e-5d4c3b2a1908"
        home.mkdir(mode=0o700)
        database = sqlite3.connect(home / "state.db")
        native_schema(database)
        database.close()
        os.chown(home / "state.db", 1, 1)
        os.chmod(home / "state.db", 0o600)
        if str(home / "state.db") not in grant_state_read(home):
            raise SystemExit("a state.db owned by another uid was not reported")
        require_private(home / "state.db")
        require_granted(home, "--x", owner="rwx")

        subprocess.run(["setfacl", "-b", str(home)], check=True)
        os.chown(home, 1, 1)
        os.chown(home / "state.db", 0, 0)
        if str(home) not in grant_state_read(home):
            raise SystemExit("a run home owned by another uid was not reported")
        require_private(home)
        require_private(home / "state.db")


def native_schema(connection):
    connection.execute("PRAGMA journal_mode=WAL")
    connection.execute(
        "CREATE TABLE IF NOT EXISTS sessions (id TEXT PRIMARY KEY, parent_session_id TEXT, cwd TEXT,"
        " model_config TEXT, source TEXT, started_at REAL, ended_at REAL, end_reason TEXT,"
        " last_activity_at REAL, session_key TEXT)"
    )
    connection.execute("CREATE TABLE IF NOT EXISTS messages (session_id TEXT, timestamp REAL)")
    connection.commit()


if sys.argv[1:] == ["--other-owner"]:
    other_owner_case()
    raise SystemExit(0)

with tempfile.TemporaryDirectory() as scratch:
    scratch = Path(scratch)
    shared = scratch / "worker-hermes"
    shared.mkdir(mode=0o700)
    (shared / "auth.json").write_text(json.dumps({
        "version": 1,
        "providers": {},
        "credential_pool": {"openrouter": [{"id": "k", "access_token": "test-not-a-secret"}]},
    }))
    adapter.WORKER_HERMES_HOME = shared

    root = scratch / ".hermes-worker"
    root.mkdir(mode=0o700)
    home = root / "8d0f3e8e-0c55-4b4e-9a53-6c1f00e3f6a1"
    adapter.prepare_runtime_home(home, fresh=True, access="write")
    adapter.seed_worker_auth(home, "openrouter")
    if not (home / "auth.json").is_file():
        raise SystemExit("the adapter did not seed auth.json")

    # What Hermes does: a WAL database kept open, every file chmodded 0600.
    writer = sqlite3.connect(home / "state.db")
    native_schema(writer)
    writer.execute("INSERT INTO sessions (id) VALUES ('20261028_120000_abcdef')")
    writer.commit()
    for name in adapter.STATE_READ_FILES:
        if not (home / name).exists():
            raise SystemExit(f"SQLite did not create {name}")
        os.chmod(home / name, 0o600)

    grant = adapter.StateReadGrant(home)
    grant.refresh(force=True)
    if grant.reported:
        raise SystemExit("the grant reported a failure on a clean run home")
    require_granted(root, "r-x", owner="rwx")
    require_granted(home, "--x", owner="rwx")
    for name in adapter.STATE_READ_FILES:
        require_granted(home / name, "r--")
    for name in ("auth.json", "config.yaml", ".no-bundled-skills"):
        require_private(home / name)
    if default_acl(home) or default_acl(root):
        raise SystemExit("a default ACL would pass the grant on to new files")

    # Files made after the grant (Hermes's own writes, a private subdirectory) stay private.
    (home / "models_dev_cache.json").write_text("{}")
    (home / "sessions").mkdir(mode=0o700, exist_ok=True)
    (home / "sessions" / "transcript.json").write_text("[]")
    adapter._write_private_json(home / "auth.json", {"version": 1, "providers": {}})
    grant.refresh(force=True)
    for path in (home / "models_dev_cache.json", home / "sessions", home / "sessions" / "transcript.json",
                 home / "auth.json"):
        require_private(path)

    # Hermes's next writer open chmods 0600 and zeroes the mask; the refresh restores it.
    os.chmod(home / "state.db", 0o600)
    os.chmod(home, 0o700)
    if granted(home / "state.db", "r--"):
        raise SystemExit("chmod 0600 did not reset the mask; the reset case is not exercised")
    grant.refresh(force=True)
    require_granted(home / "state.db", "r--")
    require_granted(home, "--x", owner="rwx")

    # Hermes closes, SQLite removes -wal/-shm and recreates them without an ACL on the next open.
    writer.close()
    for name in ("state.db-wal", "state.db-shm"):
        if (home / name).exists():
            raise SystemExit(f"{name} survived the last close; the recreate case is not exercised")
    writer = sqlite3.connect(home / "state.db")
    writer.execute("INSERT INTO sessions (id) VALUES ('20261028_120001_abcdef')")
    writer.commit()
    if granted(home / "state.db-wal", "r--"):
        raise SystemExit("the recreated WAL already carried the grant; the case is not exercised")
    grant.refresh(force=True)
    for name in adapter.STATE_READ_FILES:
        require_granted(home / name, "r--")

    # The refresh is throttled, so the supervision loop can call it every iteration.
    os.chmod(home / "state.db", 0o600)
    grant.refresh()
    if granted(home / "state.db", "r--"):
        raise SystemExit("an unforced refresh ran inside the refresh interval")
    grant.refresh(force=True)

    # The grant user is looked up once per run, not at every refresh.
    lookups = []
    real_getpwnam = adapter.pwd.getpwnam
    adapter.pwd.getpwnam = lambda name: lookups.append(name) or real_getpwnam(name)
    try:
        counted = adapter.StateReadGrant(home)
        for _ in range(3):
            counted.refresh(force=True)
    finally:
        adapter.pwd.getpwnam = real_getpwnam
    if lookups != [READER]:
        raise SystemExit(f"the grant user was looked up {len(lookups)} times for one run, not once")

    # The adapter's own resume checks accept the granted home and database.
    adapter.prepare_runtime_home(home, fresh=False, access="write")
    adapter._native_state_connection(home).close()

    # A planted symlink under a state name is never followed.
    writer.close()
    for name in ("state.db-wal", "state.db-shm"):
        (home / name).unlink(missing_ok=True)
    os.symlink("auth.json", home / "state.db-shm")
    if str(home / "state.db-shm") not in grant_state_read(home):
        raise SystemExit("a state.db-shm symlink to auth.json was not reported")
    require_private(home / "auth.json")
    (home / "state.db-shm").unlink()

    # A second link to auth.json under a state name is refused.
    os.link(home / "auth.json", home / "state.db-wal")
    if str(home / "state.db-wal") not in grant_state_read(home):
        raise SystemExit("a state.db-wal hard link to auth.json was not reported")
    require_private(home / "auth.json")
    (home / "state.db-wal").unlink()

    # The same two with a real database behind them, which the header check would pass: only the
    # no-follow open and the one-link check keep the decoy private.
    decoy = scratch / "decoy.db"
    decoy_db = sqlite3.connect(decoy)
    native_schema(decoy_db)
    decoy_db.close()
    os.chmod(decoy, 0o600)
    os.rename(home / "state.db", home / "state.db.aside")
    os.symlink(decoy, home / "state.db")
    if str(home / "state.db") not in grant_state_read(home):
        raise SystemExit("a state.db symlink to a database elsewhere was not reported")
    require_private(decoy)
    (home / "state.db").unlink()
    os.link(decoy, home / "state.db")
    if str(home / "state.db") not in grant_state_read(home):
        raise SystemExit("a state.db hard link to a database elsewhere was not reported")
    require_private(decoy)
    (home / "state.db").unlink()
    os.rename(home / "state.db.aside", home / "state.db")

    # auth.json renamed to a state name is refused: it does not start the way SQLite writes that file.
    for name in adapter.STATE_READ_FILES:
        aside = home / f"{name}.aside"
        if (home / name).exists():
            os.rename(home / name, aside)
        os.rename(home / "auth.json", home / name)
        if str(home / name) not in grant_state_read(home):
            raise SystemExit(f"auth.json renamed to {name} was not reported")
        require_private(home / name)
        os.rename(home / name, home / "auth.json")
        if aside.exists():
            os.rename(aside, home / name)

    # SQLite's own first states pass: an empty file under each name, and a -shm it has sized but not
    # yet filled in is left for the next refresh without a report.
    for name in ("state.db-wal", "state.db-shm"):
        (home / name).write_bytes(b"")
    if grant_state_read(home):
        raise SystemExit("an empty -wal or -shm was refused")
    for name in ("state.db-wal", "state.db-shm"):
        require_granted(home / name, "r--")
    (home / "state.db-shm").unlink()
    (home / "state.db-shm").write_bytes(bytes(32768))
    if grant_state_read(home):
        raise SystemExit("a zero-filled -shm was reported")
    require_private(home / "state.db-shm")
    for name in ("state.db-wal", "state.db-shm"):
        (home / name).unlink()

    # A run home swapped for a symlink grants nothing behind it, not even under the state names.
    elsewhere = scratch / "elsewhere"
    elsewhere.mkdir(mode=0o700)
    target_db = sqlite3.connect(elsewhere / "state.db")
    native_schema(target_db)
    for name in adapter.STATE_READ_FILES:
        os.chmod(elsewhere / name, 0o600)
    linked = root / "4a1c2b3d-5e6f-4a7b-8c9d-0e1f2a3b4c5d"
    os.symlink(elsewhere, linked)
    if str(linked) not in grant_state_read(linked):
        raise SystemExit("a symlinked run home was not reported")
    require_private(elsewhere)
    for name in adapter.STATE_READ_FILES:
        require_private(elsewhere / name)
    target_db.close()
    linked.unlink()

    # check_directory still refuses any other group or other access.
    for mode, reason in ((0o770, "group rwx"), (0o707, "other rwx"), (0o750, "group r-x"), (0o711, "other --x")):
        os.chmod(home, mode)
        refused(home, f"a resume home with {reason}")
    os.chmod(home, 0o700)
    grant.refresh(force=True)
    subprocess.run(["setfacl", "-m", f"u:{READER}:r-x", str(home)], check=True)
    refused(home, f"a resume home granting {READER} r-x")
    subprocess.run(["setfacl", "-m", f"u:{READER}:--x,g:{os.getgid()}:--x", str(home)], check=True)
    refused(home, "a resume home with an extra group entry")
    subprocess.run(["setfacl", "-b", str(home)], check=True)
    grant.refresh(force=True)
    adapter.check_directory(home, fresh=False)
    subprocess.run(["setfacl", "-d", "-m", f"u:{READER}:r--", str(home)], check=True)
    refused(home, "a resume home with a default ACL")
    if str(home) not in grant_state_read(home):
        raise SystemExit("a home with a default ACL was granted without a report")
    subprocess.run(["setfacl", "-k", str(home)], check=True)
    adapter.check_directory(home, fresh=False)

    # A granted database that also lets group or other in is refused at resume.
    os.chmod(home / "state.db", 0o644)
    try:
        adapter._native_state_connection(home)
    except adapter.BridgeError as exc:
        if exc.code != "resume_state_invalid":
            raise SystemExit(f"an open state.db was refused with {exc.code}")
    else:
        raise SystemExit("an other-readable state.db was accepted at resume")

    # A whole run through main(): the grant holds while Hermes runs and after it exits.
    fake = scratch / "fake-hermes.py"
    fake.write_text(FAKE_HERMES)
    report = scratch / "fake-hermes.report"
    run_home = root / "1b2c3d4e-5f60-4718-8a9b-0c1d2e3f4a5b"
    returncode, events = run_adapter_main(run_home, fake, report)
    if returncode != 0 or events[-1].get("event") != "final":
        raise SystemExit(f"the fake run did not finish: {returncode} {events}")
    if any(event.get("event") == "warning" for event in events):
        raise SystemExit(f"a clean run reported a grant failure: {events}")
    if report.read_text() != "granted":
        raise SystemExit("while Hermes ran, its chmod 0600 was not undone by the adapter's refresh")
    require_granted(root, "r-x", owner="rwx")
    require_granted(run_home, "--x", owner="rwx")
    for name in adapter.STATE_READ_FILES:
        require_granted(run_home / name, "r--")
    for name in ("auth.json", "config.yaml"):
        require_private(run_home / name)

    # A parent someone else gave access to is left exactly as it is, and that is no failure.
    foreign = scratch / "foreign-parent"
    foreign.mkdir(mode=0o700)
    subprocess.run(["setfacl", "-m", "u:daemon:r-x", str(foreign)], check=True)
    before = acl(foreign)
    foreign_home = foreign / "7c8d9e0f-1a2b-4c3d-9e4f-5a6b7c8d9e0f"
    adapter.prepare_runtime_home(foreign_home, fresh=True, access="write")
    failed = grant_state_read(foreign_home)
    if failed:
        raise SystemExit(f"a parent with a foreign grant was reported: {failed}")
    if acl(foreign) != before:
        raise SystemExit(f"the parent's foreign grant was replaced: {sorted(before)} -> {sorted(acl(foreign))}")
    require_granted(foreign_home, "--x", owner="rwx")

if os.geteuid() == 0:
    other_owner_case()
elif subprocess.run(["unshare", "--map-auto", "--map-root-user", "python3", "-c",
                     "import os,tempfile; p=tempfile.mkstemp()[1]; os.chown(p,1,1)"],
                    capture_output=True).returncode == 0:
    # Root mapped in a user namespace can set an ACL on a file it does not own, as real root can.
    subprocess.run(["unshare", "--map-auto", "--map-root-user", sys.executable, "-B", __file__, "--other-owner"],
                   check=True)
else:
    print("SKIP other-owner case: needs root or an unprivileged user namespace with /etc/subuid ranges")

print(f"{READER} reads state.db, -wal and -shm and traverses to them; auth.json, config.yaml and new files stay private")
