#!/usr/bin/env python3
"""A missing provider does not stop the other workers, and a sandbox that cannot start is a failed launch."""

from __future__ import annotations

from importlib.machinery import SourceFileLoader
import json
from pathlib import Path
import tempfile


# Resolved, so a symlinked client copy of this test still tests the repository files.
WORKER_HOST = Path(__file__).resolve().parents[1]
broker = SourceFileLoader(
    "agent_worker_broker_sandbox_gate", str(WORKER_HOST / "libexec" / "agent-worker-broker")
).load_module()

HOME = "/var/lib/agent-worker"
REPO = Path("/var/lib/agent-worker/workspaces/example")
UNIT = "agent-worker-example.service"

# Stands in for systemd-run: it records its arguments, then ends the way the test asks.
STUB = """#!/usr/bin/env python3
import json, pathlib, sys
here = pathlib.Path(__file__).parent
(here / "argv.json").write_text(json.dumps(sys.argv[1:]))
sys.stderr.write((here / "stderr").read_text())
raise SystemExit(int((here / "exit").read_text()))
"""


def check_missing_provider_does_not_stop_the_sandbox() -> None:
    # systemd fails a unit with 226/NAMESPACE when a ReadWritePaths entry is
    # missing, unless the entry starts with "-". Codex was removed from the main
    # host on 2026-11-07 and no worker of any provider started for four days.
    paths = broker.sandbox_write_paths("read", REPO)
    for provider in (".codex", ".claude", ".kimi"):
        assert f"-{HOME}/{provider}" in paths, provider
        assert f"{HOME}/{provider}" not in paths, provider


def check_worker_state_stays_required() -> None:
    # Without these a run cannot record what it did, so a missing one must
    # still stop the launch.
    paths = broker.sandbox_write_paths("read", REPO)
    for required in (
        f"{HOME}/.cache",
        f"{HOME}/.config",
        f"{HOME}/.state",
        f"{HOME}/.local/state/agent-workers",
        f"{HOME}/.hermes",
        f"{HOME}/.hermes-worker",
        f"{HOME}/.broker",
        "/var/lib/agent-worker-scratch",
        "/run/agent-worker",
    ):
        assert required in paths, required
    assert all(path.lstrip("-").startswith("/") for path in paths), paths


def check_only_a_write_run_may_write_the_repository() -> None:
    read = broker.sandbox_write_paths("read", REPO)
    write = broker.sandbox_write_paths("write", REPO)
    assert str(REPO) not in read
    assert write == [*read, str(REPO)]


def start(stub_dir: Path, exit_code: int, stderr: str) -> tuple[tuple[int, str], list[str]]:
    (stub_dir / "exit").write_text(str(exit_code))
    (stub_dir / "stderr").write_text(stderr)
    outcome = broker.start_worker_unit(UNIT, "Repository worker example", ["--uid", "root", "/bin/true"])
    return outcome, json.loads((stub_dir / "argv.json").read_text())


def check_a_sandbox_that_cannot_start_is_a_failed_launch() -> None:
    with tempfile.TemporaryDirectory() as raw:
        stub_dir = Path(raw)
        stub = stub_dir / "systemd-run"
        stub.write_text(STUB)
        stub.chmod(0o755)
        broker.SYSTEMD_RUN = str(stub)

        outcome, argv = start(stub_dir, 0, "")
        assert outcome == (0, ""), outcome
        # The launch waits for the worker process. With --no-block, systemd-run
        # exits 0 for a unit that then dies in sandbox setup.
        assert "--no-block" not in argv, argv
        assert "Type=exec" in argv and argv[argv.index("Type=exec") - 1] == "--property", argv
        assert argv[:2] == ["--unit", UNIT], argv
        assert argv[-3:] == ["--uid", "root", "/bin/true"], argv

        # --quiet makes systemd-run fail without a word. The caller still gets
        # a reason that says where to look.
        outcome, _ = start(stub_dir, 1, "")
        assert outcome[0] == 1, outcome
        assert f"journalctl -u {UNIT}" in outcome[1], outcome

        outcome, _ = start(stub_dir, 1, "Failed to start transient service unit: no such user\n")
        assert outcome == (1, "Failed to start transient service unit: no such user"), outcome


def main() -> int:
    check_missing_provider_does_not_stop_the_sandbox()
    check_worker_state_stays_required()
    check_only_a_write_run_may_write_the_repository()
    check_a_sandbox_that_cannot_start_is_a_failed_launch()
    print("worker sandbox paths and start OK")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
