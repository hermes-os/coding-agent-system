#!/usr/bin/env python3
"""install.sh --apply on a scratch WORKER_HOST_PREFIX tree, from a committed copy."""

from __future__ import annotations

import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

WORKER_HOST = Path(__file__).resolve().parents[1]
BROKER = "libexec/agent-worker-broker"
SOCKET_UNIT = "systemd/agent-worker-broker.socket"
RELOAD = "would run: sudo -n systemctl daemon-reload"
RESTART = "would run: sudo -n systemctl try-restart agent-worker-broker.service"


def fail(message: str) -> None:
    raise SystemExit(f"FAIL: {message}")


def git(repo: Path, *args: str) -> None:
    subprocess.run(
        [
            "git",
            "-c", "user.name=test",
            "-c", "user.email=test@localhost",
            "-c", "commit.gpgsign=false",
            "-c", "core.hooksPath=/dev/null",
            "-C", str(repo),
            *args,
        ],
        check=True,
        capture_output=True,
    )


class Host:
    def __init__(self, base: Path) -> None:
        self.base = base
        self.repo = base / "repo" / "worker-host"
        self.prefix = base / "root"
        self.home = base / "home"
        self.state = base / "launcher"
        self.fakebin = base / "fakebin"
        self.calls = base / "calls.log"
        shutil.copytree(
            WORKER_HOST, self.repo, symlinks=True,
            ignore=shutil.ignore_patterns("__pycache__"),
        )
        # The client launcher becomes a stub, so --list --active never reaches
        # the live broker: it prints runs, then promotes runs-next (a run that
        # starts during the apply).
        self.state.mkdir()
        self.set_runs("[]")
        (self.repo / "libexec/agent-worker-runner").write_text(
            "#!/bin/sh\n"
            f"cat '{self.state}/runs'\n"
            f"[ ! -f '{self.state}/runs-next' ] || mv '{self.state}/runs-next' '{self.state}/runs'\n"
        )
        git(self.repo.parent, "init", "-q")
        git(self.repo.parent, "add", "-A")
        git(self.repo.parent, "commit", "-q", "-m", "copy")
        # A prefix run must never reach sudo or systemctl.
        self.fakebin.mkdir()
        for tool in ("sudo", "systemctl"):
            stub = self.fakebin / tool
            stub.write_text(f"#!/bin/sh\necho {tool} \"$@\" >> '{self.calls}'\nexit 1\n")
            stub.chmod(0o755)

    def set_runs(self, now: str, later: str | None = None) -> None:
        (self.state / "runs").write_text(now + "\n")
        if later is not None:
            (self.state / "runs-next").write_text(later + "\n")

    def run(self, *args: str) -> subprocess.CompletedProcess[str]:
        env = {
            **os.environ,
            "PATH": f"{self.fakebin}:{os.environ['PATH']}",
            "WORKER_HOST_PREFIX": str(self.prefix),
            "WORKER_HOST_HOME": str(self.home),
        }
        return subprocess.run(
            ["bash", str(self.repo / "install.sh"), *args],
            env=env, text=True, capture_output=True, check=False, timeout=60,
        )

    def manifest(self) -> tuple[dict[str, Path], dict[str, Path], dict[str, Path]]:
        result = self.run("--check")
        system, links, copies = {}, {}, {}
        for line in result.stdout.splitlines():
            match = re.match(r"DRIFT missing\s+(\S+) \(repo (.+)\)$", line)
            if match:
                system[match.group(2)] = Path(match.group(1))
            match = re.match(r"DRIFT missing\s+(\S+) \(link to (.+)\)$", line)
            if match:
                links[match.group(1)] = self.repo / match.group(2)
            match = re.match(r"DRIFT missing\s+(\S+) \(copy of (.+)\)$", line)
            if match:
                copies[match.group(1)] = self.repo / match.group(2)
        if len(system) != 14 or len(copies) != 5:
            fail(f"installed-file map is wrong: {result.stdout}")
        return system, links, copies


def main() -> int:
    with tempfile.TemporaryDirectory() as temporary:
        host = Host(Path(temporary).resolve())
        system, links, copies = host.manifest()
        if any(Path(path).name == "test-install-apply" for path in links):
            fail("test-install-apply is linked into the cal workspace")
        for path, source in links.items():
            Path(path).parent.mkdir(parents=True, exist_ok=True)
            Path(path).symlink_to(source)
        # The shape the 2026-10-12 apply left in the profile scripts
        # directories: symlinks into the repository, which the cron guard blocks.
        for path, source in copies.items():
            Path(path).parent.mkdir(parents=True, exist_ok=True)
            Path(path).symlink_to(source)
        for rel, target in system.items():
            if rel == SOCKET_UNIT:
                continue
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(host.repo / rel, target)
        system[BROKER].write_text("#!/bin/sh\necho old broker\n")
        # The missing unit's directory exists with its own mode.
        system[SOCKET_UNIT].parent.chmod(0o750)

        # Uncommitted content is refused before anything is written.
        broker_before = system[BROKER].read_text()
        stray = host.repo / "libexec" / "stray"
        stray.write_text("untracked\n")
        edited = host.repo / "bin" / "worker-pane.sh"
        edited.write_text(edited.read_text() + "# local edit\n")
        for label in ("an untracked file and a local edit", "a local edit"):
            dirty = host.run("--apply")
            if dirty.returncode != 1 or "uncommitted changes" not in dirty.stderr:
                fail(f"apply with {label} was not refused: {dirty.stdout}{dirty.stderr}")
            if system[BROKER].read_text() != broker_before or (host.prefix / "var/backups").exists():
                fail(f"a refused apply with {label} changed the tree")
            stray.unlink(missing_ok=True)
        git(host.repo.parent, "checkout", "-q", "--", "worker-host/bin/worker-pane.sh")

        # A target it cannot read is refused, not skipped.
        if os.geteuid() != 0:
            policy = system["etc/agent-worker/defaults.json"]
            policy.chmod(0)
            try:
                blind = host.run("--apply")
            finally:
                policy.chmod(0o644)
            if blind.returncode != 1 or f"refusing: cannot read {policy}" not in blind.stderr:
                fail(f"apply skipped an unreadable target: {blind.stdout}{blind.stderr}")
            if system[BROKER].read_text() != broker_before or (host.prefix / "var/backups").exists():
                fail("a refused apply with an unreadable target changed the tree")

        applied = host.run("--apply")
        output = applied.stdout + applied.stderr
        if applied.returncode != 0:
            fail(f"apply failed: {output}")
        if RELOAD not in applied.stdout or RESTART not in applied.stdout:
            fail(f"systemctl was not echoed: {output}")
        if host.calls.exists():
            fail(f"a prefix apply called {host.calls.read_text()}")
        for rel in (BROKER, SOCKET_UNIT):
            if system[rel].read_bytes() != (host.repo / rel).read_bytes():
                fail(f"{rel} was not installed")
        if system[SOCKET_UNIT].parent.stat().st_mode & 0o777 != 0o750:
            fail("apply re-moded an existing parent directory")
        backups = list((host.prefix / "var/backups/agent-worker").glob(f"*/**/{Path(BROKER).name}"))
        if len(backups) != 1 or backups[0].read_text() != "#!/bin/sh\necho old broker\n":
            fail(f"the old broker was not backed up: {backups}")
        clean = host.run("--check")
        if clean.returncode != 0 or "DRIFT" in clean.stdout or "PENDING" in clean.stdout:
            fail(f"tree still drifts after apply: {clean.stdout}{clean.stderr}")
        # The profile scripts directories hold regular files with the
        # repository's content and mode, and the symlinks were backed up.
        for path, source in copies.items():
            copy = Path(path)
            if copy.is_symlink() or not copy.is_file():
                fail(f"{copy} is not a regular file after apply")
            if copy.read_bytes() != source.read_bytes() or copy.stat().st_mode & 0o777 != source.stat().st_mode & 0o777:
                fail(f"{copy} differs from {source} after apply")
            saved = list((host.prefix / "var/backups/agent-worker").glob(f"*{copy.parent}/{copy.name}"))
            if len(saved) != 1 or not saved[0].is_symlink():
                fail(f"the symlink at {copy} was not backed up: {saved}")
        if not all(Path(path).is_symlink() for path in links):
            fail("apply turned a client link into a file")
        # Edited content in a copy is drift, restored by apply, and the edit is kept.
        watchdog = next(Path(p) for p, s in copies.items() if s.name == "worker-watchdog.sh")
        watchdog.write_text("#!/bin/sh\n# edited\n")
        edited_check = host.run("--check")
        if edited_check.returncode != 1 or f"DRIFT content   {watchdog} differs" not in edited_check.stdout:
            fail(f"an edited copy was not reported: {edited_check.stdout}{edited_check.stderr}")
        restored = host.run("--apply")
        if restored.returncode != 0 or watchdog.is_symlink() or watchdog.read_bytes() != copies[str(watchdog)].read_bytes():
            fail(f"apply did not restore the edited copy: {restored.stdout}{restored.stderr}")
        kept = [f for f in (host.prefix / "var/backups/agent-worker").glob(f"*{watchdog.parent}/{watchdog.name}") if f.read_text() == "#!/bin/sh\n# edited\n"]
        if len(kept) != 1:
            fail("the edited copy was not backed up before apply replaced it")

        # A run starts after the broker is installed: no restart, exit 3, and
        # the restart stays pending until an idle re-run does it.
        pending = host.prefix / "var/backups/agent-worker/pending"
        system[BROKER].write_text("#!/bin/sh\necho old broker\n")
        host.set_runs("[]", later='[{"runId": "r1"}]')
        mid = host.run("--apply")
        if mid.returncode != 3 or RESTART in mid.stdout:
            fail(f"a run that started mid-apply did not stop the restart: {mid.returncode} {mid.stdout}{mid.stderr}")
        told = "broker installed but NOT restarted; run `sudo systemctl try-restart agent-worker-broker.service` when idle"
        if told not in mid.stderr:
            fail(f"the operator was not told the restart command: {mid.stderr}")
        if system[BROKER].read_bytes() != (host.repo / BROKER).read_bytes():
            fail("the broker was not installed before the restart check")
        if pending.read_text() != "try-restart agent-worker-broker.service\n":
            fail(f"the pending restart was not recorded: {pending.read_text()!r}")
        check = host.run("--check")
        if check.returncode != 1 or "DRIFT" in check.stdout or "PENDING         sudo systemctl try-restart" not in check.stdout:
            fail(f"--check did not report the pending restart: {check.stdout}{check.stderr}")
        busy = host.run("--apply")
        if busy.returncode != 1 or "worker runs active (1 " not in busy.stderr:
            fail(f"a pending restart ran while a run was active: {busy.stdout}{busy.stderr}")
        host.set_runs("[]")
        rerun = host.run("--apply")
        if rerun.returncode != 0 or RESTART not in rerun.stdout or "nothing to apply" in rerun.stdout:
            fail(f"the re-run did not finish the pending restart: {rerun.stdout}{rerun.stderr}")
        if RELOAD in rerun.stdout or pending.read_text() != "":
            fail(f"the re-run did more than the pending restart: {rerun.stdout}{pending.read_text()!r}")
        if "nothing to apply" not in host.run("--apply").stdout:
            fail("a finished restart was run again")

        # Stopped between a unit install and daemon-reload (a client path that
        # cannot be replaced): the reload is recorded, the command is printed,
        # and the next apply runs it.
        if os.geteuid() != 0:
            timer = next(t for r, t in system.items() if r.endswith(".timer"))
            timer.write_text("[Timer]\n")
            pane = next(Path(p) for p, s in copies.items() if s.name == "worker-pane.sh")
            pane.unlink()
            pane.parent.chmod(0o555)
            try:
                stopped = host.run("--apply")
            finally:
                pane.parent.chmod(0o755)
            if stopped.returncode in (0, 3) or "run `sudo systemctl daemon-reload`" not in stopped.stderr:
                fail(f"an interrupted apply did not name the reload: {stopped.returncode} {stopped.stdout}{stopped.stderr}")
            if pending.read_text() != "daemon-reload\n":
                fail(f"the pending reload was not recorded: {pending.read_text()!r}")
            if "PENDING         sudo systemctl daemon-reload" not in host.run("--check").stdout:
                fail("--check did not report the pending reload")
            finished = host.run("--apply")
            if finished.returncode != 0 or RELOAD not in finished.stdout or RESTART in finished.stdout:
                fail(f"the re-run did not finish the reload: {finished.stdout}{finished.stderr}")
            final = host.run("--check")
            if final.returncode != 0 or "DRIFT" in final.stdout or "PENDING" in final.stdout:
                fail(f"tree drifts after the reload re-run: {final.stdout}{final.stderr}")
    print("PASS: install.sh --apply refuses uncommitted content and unreadable targets, replaces profile-scripts symlinks with regular copies, installs on a prefix with systemctl echoed, keeps parent modes, and records and finishes a pending restart or reload")
    return 0


if __name__ == "__main__":
    sys.exit(main())
