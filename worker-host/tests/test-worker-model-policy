#!/usr/bin/env python3
"""Validate worker model selection, the one-run-per-launch rule and the terminal outcome contract."""

from __future__ import annotations

import argparse
import contextlib
from importlib.machinery import SourceFileLoader
import io
import json
from pathlib import Path
import sys
from unittest.mock import patch


# Resolved, so a symlinked client copy of this test still tests the repository files.
WORKER_HOST = Path(__file__).resolve().parents[1]
core = SourceFileLoader(
    "repo_worker_model_policy_gate", str(WORKER_HOST / "libexec" / "agent-worker-runner")
).load_module()
core.CLIENT_MODEL_POLICY = WORKER_HOST / "etc" / "agent-worker" / "defaults.json"


def check_shared_model_policy() -> None:
    # The default follows the policy's workerDefault (owner-tuned), not a
    # model pinned here.
    policy = core.model_policy()
    default = policy["models"][policy["workerDefault"]]["worker"]
    assert default["agent"] == "hermes"
    expected_default = ("hermes", default["model"], default["effort"])
    assert core.resolve_worker_selection(None, None, None) == expected_default
    assert core.resolve_worker_selection("hermes", None, None) == expected_default
    assert core.resolve_worker_selection(None, "luna", None) == (
        "codex",
        "gpt-5.6-luna",
        "max",
    )
    assert core.resolve_worker_selection(None, "sol", None) == (
        "codex",
        "gpt-5.6-sol",
        "medium",
    )
    assert core.resolve_worker_selection(None, "gpt-6-luna", None) == (
        "hermes",
        "gpt-6-luna",
        "max",
    )
    assert core.resolve_worker_selection("hermes", "claude-opus-5", "high") == (
        "hermes",
        "claude-opus-5",
        "high",
    )
    try:
        core.resolve_worker_selection("codex", "gpt-6-luna", None)
    except SystemExit as exc:
        assert "model is not configured" in str(exc)
    else:
        raise AssertionError("Codex CLI accepted an unlisted model")


def check_one_run_per_launch() -> None:
    """A launch whose provider is out of quota fails as itself: no second run on another model."""
    args = argparse.Namespace(
        foreground=False,
        dry_run=False,
        agent="claude",
        model=None,
        effort=None,
        mode="task",
        access="read",
        resume_run=None,
        stale_after=300,
    )
    launched: list[str] = []

    def launch_service(metadata, packet):
        launched.append(str(metadata["agent"]))
        return {"runId": f"run-{len(launched)}", "agent": metadata["agent"], "status": "queued"}

    dry_provider = {"runId": "run-1", "status": "failed", "failureDetail": "quota exceeded"}
    printed = io.StringIO()
    with (
        patch.object(core, "prepare_launch", lambda a: ({"agent": a.agent, "runId": "run-1"}, "packet")),
        patch.object(core, "assert_capacity", lambda: None),
        patch.object(core, "launch_service", launch_service),
        patch.object(core, "load_metadata", lambda run_id: {"runId": run_id}),
        patch.object(core, "status_payload", lambda metadata, stale_after: dict(dry_provider)),
        contextlib.redirect_stdout(printed),
    ):
        assert core.launch(args) == 0
    assert launched == ["claude"], launched
    summary = json.loads(printed.getvalue())
    assert summary == {"runId": "run-1", "agent": "claude", "status": "queued"}, summary


def check_terminal_outcome_contract() -> None:
    assert core.reported_outcome("OUTCOME: COMPLETED\nAll checks passed.\n") == "completed"
    assert core.reported_outcome("\nOUTCOME: BLOCKED\n.NET is unavailable.\n") == "blocked"
    assert core.reported_outcome("Outcome: completed\n") is None
    assert core.reported_outcome("Checks passed, but phone proof remains.\n") is None
    assert core.terminal_result(
        return_code=0,
        interrupted=False,
        final_text="OUTCOME: COMPLETED\nDone.\n",
    ) == ("completed", "completed", None)
    assert core.terminal_result(
        return_code=0,
        interrupted=False,
        final_text="OUTCOME: BLOCKED\nMissing required SDK.\n",
    ) == ("blocked", "blocked", "worker reported an unmet hard gate")
    assert core.terminal_result(
        return_code=0,
        interrupted=False,
        final_text="Missing required SDK.\n",
    ) == (
        "blocked",
        "unverified",
        "worker exited without a machine-readable terminal outcome",
    )
    packet = core.task_packet(
        run_id="11111111-1111-1111-1111-111111111111",
        role="test owner",
        task="Validate the contract.",
        requested_repo=Path("/work/repository"),
        repo_root=Path("/work/repository"),
        access="read",
        mode="task",
        constraints=[],
        success=["The contract is observable."],
    )
    assert "OUTCOME: COMPLETED" in packet and "OUTCOME: BLOCKED" in packet


def main() -> int:
    check_shared_model_policy()
    check_one_run_per_launch()
    check_terminal_outcome_contract()
    print("Validated worker model policy.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
