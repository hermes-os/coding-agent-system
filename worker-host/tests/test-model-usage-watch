#!/usr/bin/env python3
"""The usage watch reads the Anthropic windows correctly and holds work rather than swapping models."""

from __future__ import annotations

from importlib.machinery import SourceFileLoader
from pathlib import Path
import sys
from types import SimpleNamespace


WORKER_HOST = Path(__file__).resolve().parents[1]
watch = SourceFileLoader(
    "model_usage_watch_gate", str(WORKER_HOST / "bin" / "model-usage-watch-v20260930.py")
).load_module()


def window(label: str, used: float) -> SimpleNamespace:
    return SimpleNamespace(label=label, used_percent=used, reset_at="2026-11-15T00:00:00Z")


def check_anthropic_state() -> None:
    # No week window: usage is unknown.
    assert watch.anthropic_state([]) == {"open": None}
    assert watch.anthropic_state([window("Current session", 10.0)]) == {"open": None}

    # The usage API sends no session window while no 5-hour session runs. That is 0% used, not unknown.
    idle = watch.anthropic_state([window("Current week", 12.0)])
    assert idle["open"] is True, idle
    assert idle["session_used"] == 0.0 and idle["session_reset"] is None, idle
    assert idle["week_used"] == 12.0, idle

    full = watch.CLOSED_AT
    assert watch.anthropic_state([window("Current session", full), window("Current week", 12.0)])["open"] is False
    assert watch.anthropic_state([window("Current session", 5.0), window("Current week", full)])["open"] is False


def check_closed_window_holds() -> None:
    """A closed or unknown window holds every kind of work. It never routes to another model."""
    for state in ({"open": None}, {"open": False}):
        reason, routes = watch.decide(state)
        assert reason == "hold-anthropic-closed", reason
        assert set(routes) == set(watch.KINDS) and all(route is None for route in routes.values()), routes
    reason, routes = watch.decide({"open": True})
    assert set(routes) == set(watch.KINDS) and all(route for route in routes.values()), routes


def main() -> int:
    check_anthropic_state()
    check_closed_window_holds()
    print("Validated usage watch routing.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
