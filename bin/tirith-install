#!/usr/bin/env python3
"""Install the tirith security scanner system-wide for all agent accounts.

Downloads the latest release archive for this platform, verifies its SHA-256
against the release checksum manifest, and installs the binary to a location
every user (including isolated worker accounts) can execute. Per-user profile
installs are invisible to isolated workers; without a system-wide binary their
command scanning silently degrades to pattern matching.
"""

from __future__ import annotations

import argparse
import hashlib
import os
import platform
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.request
from pathlib import Path

RELEASE_BASE = "https://github.com/sheeki03/tirith/releases/latest/download"
DEFAULT_DESTINATION = "/usr/local/bin/tirith"

_TARGETS = {
    ("Linux", "x86_64"): "x86_64-unknown-linux-gnu",
    ("Linux", "aarch64"): "aarch64-unknown-linux-gnu",
    ("Darwin", "arm64"): "aarch64-apple-darwin",
    ("Darwin", "x86_64"): "x86_64-apple-darwin",
}


def detect_target() -> str:
    key = (platform.system(), platform.machine())
    target = _TARGETS.get(key)
    if target is None:
        raise SystemExit(f"tirith-install: unsupported platform {key[0]}/{key[1]}")
    return target


def download(url: str, destination: Path) -> None:
    with urllib.request.urlopen(url, timeout=60) as response, destination.open("wb") as out:
        shutil.copyfileobj(response, out)


def expected_checksum(checksums: Path, archive_name: str) -> str:
    for line in checksums.read_text(encoding="utf-8").splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[1] == archive_name:
            return parts[0]
    raise SystemExit(f"tirith-install: {archive_name} missing from checksum manifest")


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def extract_binary(archive: Path, workdir: Path) -> Path:
    with tarfile.open(archive, "r:gz") as tar:
        member = next(
            (m for m in tar.getmembers() if m.isfile() and Path(m.name).name == "tirith"),
            None,
        )
        if member is None:
            raise SystemExit("tirith-install: archive does not contain a tirith binary")
        tar.extract(member, workdir, filter="data")
        return workdir / member.name


def installed_version(binary: Path) -> str | None:
    if not binary.is_file() or not os.access(binary, os.X_OK):
        return None
    result = subprocess.run(
        [str(binary), "--version"], capture_output=True, text=True, timeout=15, check=False
    )
    return result.stdout.strip() if result.returncode == 0 else None


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument(
        "--destination",
        type=Path,
        default=Path(DEFAULT_DESTINATION),
        help=f"install path for the binary (default: {DEFAULT_DESTINATION})",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="reinstall even when the destination already matches the latest release",
    )
    args = parser.parse_args()

    target = detect_target()
    archive_name = f"tirith-{target}.tar.gz"

    with tempfile.TemporaryDirectory(prefix="tirith-install-") as tmp:
        workdir = Path(tmp)
        checksums = workdir / "checksums.txt"
        download(f"{RELEASE_BASE}/checksums.txt", checksums)
        expected = expected_checksum(checksums, archive_name)

        archive = workdir / archive_name
        download(f"{RELEASE_BASE}/{archive_name}", archive)
        actual = sha256_file(archive)
        if actual != expected:
            raise SystemExit(
                f"tirith-install: checksum mismatch for {archive_name}: "
                f"expected {expected}, got {actual}"
            )

        binary = extract_binary(archive, workdir)
        binary.chmod(0o755)

        current = args.destination
        if not args.force and current.is_file() and sha256_file(current) == sha256_file(binary):
            print(f"tirith-install: {current} already current ({installed_version(current)})")
            return

        version = installed_version(binary)
        if version is None:
            raise SystemExit("tirith-install: staged binary failed --version")

        args.destination.parent.mkdir(parents=True, exist_ok=True)
        staged = args.destination.with_name(f".{args.destination.name}.staged")
        shutil.copy2(binary, staged)
        os.replace(staged, args.destination)
        print(f"tirith-install: installed {version} at {args.destination}")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
