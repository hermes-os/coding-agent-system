#!/usr/bin/env bash
# app-script <repo>: print the setup script to save in the Claude app for
# <repo>'s cloud environment. It loads cloud/common.sh, cloud/<repo>.sh and
# working-agreement.md from this repository's GitHub copy and runs
# cloud/<repo>.sh, so the app needs a new copy only when the loader changes.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
repo=${1:?usage: app-script <repo>}
[ -f "$here/$repo.sh" ] || { echo "app-script: no cloud/$repo.sh" >&2; exit 1; }
cat <<EOF
#!/bin/bash
# Loads and runs cloud/$repo.sh from github.com/hermes-os/coding-agent-system.
# Printed by cloud/app-script $repo. The app reruns it about weekly; to run it
# now, change this date and save: $(date +%F)
d=/opt/cloud-setup
u=https://raw.githubusercontent.com/hermes-os/coding-agent-system/main
mkdir -p "\$d/cloud"
for f in cloud/common.sh cloud/$repo.sh working-agreement.md; do
    curl -fsSL --retry 3 -o "\$d/\$f" "\$u/\$f" || { echo "setup: could not load \$f"; exit 0; }
done
exec bash "\$d/cloud/$repo.sh"
EOF
